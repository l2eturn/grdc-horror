# Writes a .cpp defining ter::builtinShader(file) that returns the text of every shaders/*.vert / *.frag,
# so a game that links terEngine does not need the shaders folder next to it.
function(ter_embed_shaders out_file)
  file(GLOB shader_files CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/shaders/*.vert" "${CMAKE_CURRENT_SOURCE_DIR}/shaders/*.frag")
  list(SORT shader_files)
  set(body "// Generated by cmake/EmbedShaders.cmake — edit the files in terEngine/shaders instead.\n#include <cstring>\n#include <string>\n\nnamespace ter {\n\nconst char* builtinShader(const std::string& file) {\n")
  foreach(f ${shader_files})
    get_filename_component(name ${f} NAME)
    file(READ ${f} src)
    string(APPEND body "    if (file == \"${name}\") return R\"TERSHADER(${src})TERSHADER\";\n")
  endforeach()
  string(APPEND body "    return nullptr;\n}\n\n}  // namespace ter\n")
  # only touch the file when it changes, so editing CMake does not rebuild everything
  if(EXISTS ${out_file})
    file(READ ${out_file} old)
  endif()
  if(NOT "${old}" STREQUAL "${body}")
    file(WRITE ${out_file} "${body}")
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${shader_files})
endfunction()
