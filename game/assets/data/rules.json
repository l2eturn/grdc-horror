    {
      "id": "phantom_buzz",
      "at": "22:05",
      "text": "3. ถ้าโทรศัพท์สั่นแต่ไม่มีข้อความใหม่เข้ามา ห้ามหยิบโทรศัพท์ขึ้นมาและห้ามเปิดอ่านข้อความ ให้รอจนครบ 10 วินาทีก่อน",
      "check": { "at": "22:30", "seconds": 10, "signal": "phone_buzz", "type": "phone_held", "onViolate": { "sound": "sting" } }
    },
    {
      "id": "shadow",
      "at": "22:06",
      "text": "4. ถ้าเห็นเงาคนยืนนิ่งอยู่ริมราวกันตกฝั่งตรงข้ามถนน ห้ามมองมันรวมกันเกิน 3 วินาที ให้หันไปทางอื่นทันที มันจะรู้ว่าคุณเห็นมัน",
      "check": { "at": "22:50", "seconds": 25, "signal": "shadow_figure", "type": "look_at", "target": [-14, 1.5, -7.0], "coneDeg": 12, "max": 3, "onViolate": { "sound": "whisper", "hide": "shadow_figure" } }
