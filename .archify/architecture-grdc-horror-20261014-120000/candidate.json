  {
   "dot": "emerald",
   "title": "Game (game/src)",
   "items": [
    "main.cpp owns the per-frame loop and wires every system",
    "Night clock releases rule messages into the phone Inbox",
    "BusEvent + Dialogue run the driver encounter"
   ]
  },
  {
   "dot": "cyan",
   "title": "terEngine",
   "items": [
    "C++20 / OpenGL / GLFW static library, three.js-style API",
    "Deps fetched: glm, cgltf, meshoptimizer, nlohmann/json, miniaudio",
    "ter_add_game() bundles assets into grdc-horror.app"
   ]
  },
  {
   "dot": "amber",
   "title": "Data-driven content",
   "items": [
    "Level, clock, battery, rules, dialogue and bus come from JSON",
    "Models authored by Blender scripts, exported as .glb",
    "Textures are procedurally drawn in Textures.cpp"
   ]
  }
 ]
