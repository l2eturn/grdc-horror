  "hideSpots": [
    { "id": "under_bench", "eye": [0.9, 0.32, 2.36], "yawDeg": 0, "radius": 1.3, "lookDeg": 45 },
    // "kind": "sit" = a seat (rule 9: up on the bench until the dragging stops), next to where the companion sits
