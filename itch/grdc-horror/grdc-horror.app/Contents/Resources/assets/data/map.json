// Bus stop on a mountain road. Units are meters.
// Axes: +X = east (right), -Z = north (forward), +Y = up. The shelter is at the origin.
// North of the road: guardrail, then a cliff down into the foggy valley. South: forest, path down to the village.
// Format reference: game/MAP_FORMAT.md
{
  "atmosphere": {
    "hemiSky": "#26303e", "hemiGround": "#07080a", "hemiIntensity": 0.3,
    "fogColor": "#10151b", "visibility": 28, "fogHeight": 3.5,
    "vignette": 1.15, "warm": -0.06, "grain": 0.012
  },

  "sky": {
