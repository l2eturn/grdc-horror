    { "type": "rocks", "count": 10, "seed": 8, "min": [-44, -8.5], "max": [44, -7.9], "scale": [0.2, 0.5] },
    { "type": "grass", "count": 1600, "seed": 3, "min": [-34, -0.2], "max": [34, 32],
      "clear": [ { "min": [-2.8, -0.2], "max": [2.8, 3.2] }, { "min": [4.3, 0], "max": [5.7, 25] } ] },
    { "type": "grass", "count": 160, "seed": 6, "min": [-45, -8.5], "max": [45, -7.6] },


    // ---- drifting smoke: between the trees, over the road, and rising out of the valley
    { "type": "smoke", "count": 45, "seed": 21, "min": [-34, -6], "max": [34, 32], "size": [5, 10], "height": [0.8, 2.6], "opacity": 0.4 },
    { "type": "smoke", "count": 18, "seed": 22, "min": [-45, -26], "max": [45, -10], "size": [16, 26], "height": [-6, -2], "opacity": 0.3 },

    // ---- the companion (placeholder person) waiting in the shelter
    { "type": "companion", "pos": [-1.4, 0.18, 1.85] },

    // ---- rule events, hidden until their time (rules.json "check" signals)
    // rule 11: a bag just like yours on the far end of the bench
    { "type": "bag", "pos": [1.6, 0.63, 2.3], "rotY": -10 },
    // rule 4: a figure standing still across the road, by the guardrail
    { "type": "shadow_figure", "pos": [-14, 0, -7.0], "rotY": 0 }
