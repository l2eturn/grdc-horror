    { "type": "bin", "pos": [4.1, 0, 0.4] },

    // ---- street lamps: one working (flickers), one dead across the road
    { "type": "lamp_post", "id": "lamp_west", "pos": [-5.5, 0, -0.6], "rotY": 180, "height": 6, "reach": 1.8, "intensity": 2.4, "range": 11, "flicker": 0.04 },
