    { "type": "strip", "from": [-45, -7.8], "to": [45, -7.8], "width": 1.6, "texture": "dirt", "tile": 3, "color": "#9a958c" },
    { "type": "strip", "from": [-45, -0.5], "to": [45, -0.5], "width": 1.0, "texture": "dirt", "tile": 3, "color": "#9a958c" },

    // ---- on the road surface: puddles, fallen needles along the edges, oil stains, an old skid mark
    { "type": "puddles", "count": 16, "seed": 31, "min": [-30, -6.6], "max": [30, -1.4], "size": [0.5, 1.8] },
    { "type": "decals", "texture": "litter", "count": 70, "seed": 32, "min": [-30, -7.4], "max": [30, -6.3], "size": [0.5, 1.1] },
    { "type": "decals", "texture": "litter", "count": 60, "seed": 33, "min": [-30, -1.7], "max": [30, -0.2], "size": [0.5, 1.1] },
