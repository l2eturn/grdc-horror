    { "type": "gutter", "from": [-30, -0.7], "to": [-3.4, -0.7], "width": 0.5 },
    { "type": "gutter", "from": [5.0, -0.7], "to": [30, -0.7], "width": 0.5 },
    { "type": "km_post", "pos": [-13, 0, -0.25], "route": "1095", "place": "ดอยหมอก", "km": 12 },
    { "type": "road_sign", "pos": [24, 0, -0.3], "rotY": -90, "shape": "diamond", "symbol": "curve_left", "text": "ทางโค้ง" },
